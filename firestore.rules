rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Client reads:
    // - profiles/{uid}/covers (owner list, ordered by timestamp)
    // - profiles/{uid}/covers/{id} and publicImages/{id} (single gets)
    // Credits, payments, covers, and the public mirror are written with the
    // Admin SDK, which bypasses these rules. The client SDK is in the bundle,
    // so a client write allow is a real write path.

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // users/{uid} plus profile/userData and payments/{id}. Owner read only.
    match /users/{uid} {
      allow get: if isOwner(uid);
    }

    match /users/{uid}/{document=**} {
      allow read: if isOwner(uid);
    }

    // profiles/{uid}/covers/{id}. Owner read only. A client-created cover
    // would also satisfy any future public-image ownership check.
    match /profiles/{uid}/{document=**} {
      allow read: if isOwner(uid);
    }

    // publicImages are read through GET /api/images/:id (Admin SDK).
    // The client SDK must not read or list them.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
